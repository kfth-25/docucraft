{
  "name": "docucraft-hocuspocus-server",
  "version": "1.0.0",
  "description": "Hocuspocus Yjs server for DocuCraft real-time collaboration",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "watch": "nodemon --exec ts-node src/server.ts"
  },
  "dependencies": {
    "@hocuspocus/server": "^2.10.0",
    "@hocuspocus/extension-database": "^2.10.0",
    "@hocuspocus/extension-logger": "^2.10.0",
    "jsonwebtoken": "^9.0.0",
    "ws": "^8.14.0",
    "yjs": "^13.6.0",
    "sql.js": "^1.10.3",
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "nodemon": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}